[Unit]
Description=Arm nasmount network shares
# local-fs.target: /etc and /run must be mounted before this can even open
# its own state. remote-fs-pre.target: ordering hook network filesystem
# mount units use to run before the actual network mounts; being ordered
# after it (not before) means this always has a chance to install its
# autofs triggers ahead of any consumer that waits for remote-fs.target.
After=local-fs.target remote-fs-pre.target
# Both directives are required together, not either alone:
# Wants= pulls remote-fs.target into the boot transaction even when no other
# network filesystem exists on the host, so Before= actually constrains
# something; Before= is what stops a consumer ordered After=remote-fs.target
# from reaching a share's local directory before its autofs trigger exists.
Wants=remote-fs.target
Before=remote-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@KDE_INSTALL_FULL_LIBEXECDIR@/nasmount-boot
# Only arms autofs triggers, never mounts, so an unreachable NAS cannot make
# this run long; bounds a pathological run rather than an expected one.
TimeoutStartSec=60
# This runs directly under systemd with no dedicated SELinux domain, so it
# inherits init_t, whose targeted policy denies execmem. Qt's QRegularExpression
# (used throughout kde_nasmount-core for unit-file parsing) otherwise JIT-compiles
# patterns via PCRE2, which needs execmem to do so. Disabling the JIT avoids
# that denial instead of granting the permission; matching a handful of short
# strings once at boot costs nothing without it.
Environment=QT_ENABLE_REGEXP_JIT=0

[Install]
WantedBy=multi-user.target
