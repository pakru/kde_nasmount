[Domain]
Name=nasmount
Icon=drive-network

# Every mutation here is auth_admin. A share is boot-owned and persistent,
# and its credential is stored root-owned on disk indefinitely --
# the equivalent by hand is sudo-editing /etc, so creating or removing one
# requires authentication exactly like that would.
#
# There is deliberately no passwordless (Policy=yes) mutation. Nothing needs
# one: shares are armed at boot by nasmount-boot, which runs as root and
# authorizes nothing, so no action is ever invoked unattended.
#
# "auth_admin_keep" (briefly caching admin auth so several actions in a row
# do not each re-prompt) would be the natural choice, but kauth-policy-gen's
# own Policy-value grammar (invent.kde.org/frameworks/kauth
# src/policy-gen/policy-gen.cpp) only ever accepts yes|no|auth_self|auth_admin
# -- it has never generated a "_keep" .policy entry, even though polkit itself
# understands one. Plain auth_admin is used here instead: strictly more
# conservative (it re-prompts every time rather than caching), never less.
#
# inventory stays Policy=yes: it is read-only, caller-scoped, and the KCM
# refreshes it constantly -- prompting there would make the module unusable.
# PolicyInactive=no keeps everything off non-active and remote sessions.
#
# Translations are Name[ll]= and Description[ll]= beside the English keys. No
# Name or Description, translated or not, may contain a comma, semicolon,
# double quote or backslash: kauth-policy-gen reads this file through QSettings,
# which turns a comma into a list (the whole value is then written out empty),
# cuts a value at a semicolon and drops double quotes and backslashes. The
# generator reports none of it, so tests/translations_gate.sh refuses these
# characters; the generated .policy is the only other place it shows.
[io.github.pakru.nasmount.definesystem]
Name=Define a boot-time network mount
Name[ru]=Определение сетевого подключения с монтированием при загрузке
Name[de]=Ein beim Systemstart eingehängtes Netzwerklaufwerk definieren
Name[fr]=Définir un montage réseau au démarrage
Name[es]=Definir un montaje de red en el arranque
Name[pt_BR]=Definir uma montagem de rede na inicialização
Name[zh_CN]=定义开机网络挂载
Description=Authentication is required to define a boot-time network mount
Description[ru]=Для определения сетевого подключения с монтированием при загрузке требуется аутентификация
Description[de]=Zum Definieren eines beim Systemstart eingehängten Netzwerklaufwerks ist eine Authentifizierung erforderlich
Description[fr]=Une authentification est requise pour définir un montage réseau au démarrage
Description[es]=Se necesita autenticación para definir un montaje de red en el arranque
Description[pt_BR]=É necessária autenticação para definir uma montagem de rede na inicialização
Description[zh_CN]=需要身份验证才能定义开机网络挂载
Policy=auth_admin
PolicyInactive=no

[io.github.pakru.nasmount.undefinesystem]
