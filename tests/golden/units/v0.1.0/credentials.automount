# Managed by nasmount — do not edit by hand; use the KCM or the dialog.
# X-Nasmount-Managed=1
# X-Nasmount-Owner-Uid=1000
# X-Nasmount-Owner-Gid=1000
# X-Nasmount-Id=0123456789abcdef0123456789abcdef
# X-Nasmount-Mode=system
# X-Nasmount-Authentication=credentials
[Unit]
Description=nasmount automount: /home/tester/mnt/media
ConditionPathIsDirectory=/home/tester/mnt/media

[Automount]
Where=/home/tester/mnt/media
TimeoutIdleSec=60
DirectoryMode=0700
