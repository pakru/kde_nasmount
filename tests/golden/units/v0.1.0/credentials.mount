# Managed by nasmount — do not edit by hand; use the KCM or the dialog.
# X-Nasmount-Managed=1
# X-Nasmount-Owner-Uid=1000
# X-Nasmount-Owner-Gid=1000
# X-Nasmount-Id=0123456789abcdef0123456789abcdef
# X-Nasmount-Mode=system
# X-Nasmount-Authentication=credentials
[Unit]
Description=nasmount: //nas.example.org/media

[Mount]
What=//nas.example.org/media
Where=/home/tester/mnt/media
Type=cifs
Options=credentials=/etc/nasmount/0123456789abcdef0123456789abcdef.cred,nosuid,nodev,forceuid,forcegid,uid=1000,gid=1000,nounix,iocharset=utf8,file_mode=0600,dir_mode=0700
TimeoutSec=30
