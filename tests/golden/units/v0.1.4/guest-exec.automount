# Managed by nasmount — do not edit by hand; use the KCM or the dialog.
# X-Nasmount-Managed=1
# X-Nasmount-Owner-Uid=1000
# X-Nasmount-Owner-Gid=1000
# X-Nasmount-Id=1a2b3c4d5e6f708192a3b4c5d6e7f809
# X-Nasmount-Mode=system
# X-Nasmount-Authentication=guest
# X-Nasmount-Access=readwrite-executable
[Unit]
Description=nasmount automount: /home/tester/mnt/games
ConditionPathIsDirectory=/home/tester/mnt/games

[Automount]
Where=/home/tester/mnt/games
TimeoutIdleSec=60
DirectoryMode=0700
