# Managed by nasmount — do not edit by hand; use the KCM or the dialog.
# X-Nasmount-Managed=1
# X-Nasmount-Owner-Uid=1000
# X-Nasmount-Owner-Gid=1000
# X-Nasmount-Id=00112233445566778899aabbccddeeff
# X-Nasmount-Mode=system
# X-Nasmount-Authentication=credentials
# X-Nasmount-Access=readonly
[Unit]
Description=nasmount: //nas.example.org/archive

[Mount]
What=//nas.example.org/archive
Where=/home/tester/mnt/archive
Type=cifs
Options=credentials=/etc/nasmount/00112233445566778899aabbccddeeff.cred,nosuid,nodev,forceuid,forcegid,uid=1000,gid=1000,nounix,iocharset=utf8,ro,file_mode=0400,dir_mode=0500
TimeoutSec=30
