# Managed by nasmount — do not edit by hand; use the KCM or the dialog.
# X-Nasmount-Managed=1
# X-Nasmount-Owner-Uid=1000
# X-Nasmount-Owner-Gid=1000
# X-Nasmount-Id=0f1e2d3c4b5a69788796a5b4c3d2e1f0
# X-Nasmount-Mode=system
# X-Nasmount-Authentication=credentials
# X-Nasmount-Access=readwrite-executable
[Unit]
Description=nasmount automount: /home/tester/mnt/steam
ConditionPathIsDirectory=/home/tester/mnt/steam

[Automount]
Where=/home/tester/mnt/steam
TimeoutIdleSec=60
DirectoryMode=0700
