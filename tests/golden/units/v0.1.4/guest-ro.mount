# Managed by nasmount — do not edit by hand; use the KCM or the dialog.
# X-Nasmount-Managed=1
# X-Nasmount-Owner-Uid=1000
# X-Nasmount-Owner-Gid=1000
# X-Nasmount-Id=ffeeddccbbaa99887766554433221100
# X-Nasmount-Mode=system
# X-Nasmount-Authentication=guest
# X-Nasmount-Access=readonly
[Unit]
Description=nasmount: //nas.example.org/reference

[Mount]
What=//nas.example.org/reference
Where=/home/tester/mnt/reference
Type=cifs
Options=guest,nosuid,nodev,forceuid,forcegid,uid=1000,gid=1000,nounix,iocharset=utf8,ro,file_mode=0400,dir_mode=0500
TimeoutSec=30
