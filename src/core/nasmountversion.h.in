 *
 * VERSION is the hand-edited source of truth. CMake generates this header so
 * runtime version output cannot drift from package and plugin metadata.
 */

#pragma once

namespace Nasmount
{

/** The normalized MAJOR.MINOR.PATCH release version from the VERSION file. */
inline constexpr char Version[] = "@PROJECT_VERSION@";

} // namespace Nasmount
