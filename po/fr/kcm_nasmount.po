#: src/kcm/ui/main.qml:379
#, kde-format
msgid "Remove the network mount at %1?"
msgstr "Supprimer le montage réseau dont le point de montage est %1 ?"

#: src/kcm/ui/main.qml:381
#, kde-format
msgid ""
"Remove the definition at %1?\n"
"\n"
"You have no saved settings for it, so adding it again means entering "
"everything anew."
msgstr ""
"Supprimer la définition dont le point de montage est %1 ?\n"
"\n"
"Vous n'avez aucun paramètre enregistré pour elle ; la rajouter vous "
"obligerait à tout saisir de nouveau."

#: src/kcm/ui/main.qml:383
#, kde-format
msgid ""
"Remove your saved settings for %1?\n"
"\n"
"No mount definition is touched and nothing is unmounted."
msgstr ""
"Supprimer vos paramètres enregistrés pour %1 ?\n"
"\n"
"Aucune définition de montage n'est modifiée et rien n'est démonté."
