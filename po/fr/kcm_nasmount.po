#: src/dialog/main.cpp:71 src/dialog/qml/main.qml:38
#, kde-format
msgctxt "@title:window"
msgid "Mount as Network Drive"
msgstr "Monter comme lecteur réseau"

#: src/dialog/main.cpp:76
#, kde-format
msgid "Mounts an SMB share on demand, available again after a reboot."
msgstr ""
"Monte un partage SMB à la demande et le rend de nouveau disponible après un "
"redémarrage."

#. i18n: %1 is the URL scheme "smb://", which is not translated. Shown in
#. i18n: --help beside the argument name.
#: src/dialog/main.cpp:83
#, kde-format
msgid "%1 URL of the share to mount"
msgstr "URL du partage à monter (au format %1)"

#. i18n: %1 is the command line to type, which is not translated.
#: src/dialog/main.cpp:90
#, kde-format
msgid "Usage: %1"
msgstr "Utilisation : %1"

#: src/dialog/main.cpp:123
#, kde-format
msgid "Could not load the dialog interface."
msgstr "Impossible de charger l'interface de la boîte de dialogue."

#: src/dialog/smburl.cpp:44
#, kde-format
msgctxt "@info:status share state, in parentheses"
msgid "unknown"
msgstr "état inconnu"

#: src/dialog/smburl.cpp:48 src/dialog/smburl.cpp:55 src/dialog/smburl.cpp:60
#, kde-format
msgctxt "@info:status share state, in parentheses"
msgid "needs attention"
msgstr "nécessite une intervention"

#: src/dialog/smburl.cpp:52
#, kde-format
msgctxt "@info:status share state, in parentheses"
msgid "mounted"
msgstr "monté"

#: src/dialog/smburl.cpp:59
#, kde-format
msgctxt "@info:status share state, in parentheses"
msgid "ready - mounts on first access"
msgstr "prêt – sera monté au premier accès"

#: src/dialog/smburl.cpp:62
#, kde-format
msgctxt "@info:status share state, in parentheses"
msgid "defined, not active"
msgstr "défini, mais inactif"

#: src/kcm/kcmnasmount.cpp:135
#, kde-format
msgid "No file manager answered the request to open the folder (%1)"
msgstr ""
"Aucun gestionnaire de fichiers n'a répondu à la demande d'ouverture du "
"dossier (%1)"

#: src/session/helperinvoke.cpp:85
#, kde-format
msgid "the operation failed"
msgstr "l'opération a échoué"

#: src/session/mountactions.cpp:60
#, kde-format
msgid "connection to the helper was lost"
msgstr "la connexion avec le programme auxiliaire a été perdue"

#: src/session/mountactions.cpp:59
#, kde-format
msgid "could not confirm the result (%1) - refresh before retrying"
msgstr ""
"impossible de confirmer le résultat (%1) – actualisez avant de réessayer"

#: src/session/mountactions.cpp:126
#, kde-format
msgid ""
"a share with no username is guest, and cannot also have a password or domain"
msgstr ""
"un partage sans nom d'utilisateur utilise un accès invité et ne peut avoir "
"ni mot de passe ni domaine"

#: src/session/mountactions.cpp:150
#, kde-format
msgid "the helper returned an invalid share id"
msgstr "le programme auxiliaire a renvoyé un identifiant de partage non valide"

#: src/session/mountactions.cpp:172
#, kde-format
msgid ""
"the definition was created, but could not be saved locally (%1) - it exists "
"on this machine but will not appear here until this is resolved"
msgstr ""
"la définition a été créée, mais n'a pas pu être enregistrée localement (%1) "
"– elle existe sur cette machine, mais n'apparaîtra pas ici tant que le "
"problème n'est pas résolu"

#: src/session/mountactions.cpp:180
#, kde-format
msgid "Share added and mounted"
msgstr "Partage ajouté et monté"

#: src/session/mountactions.cpp:181
#, kde-format
msgid "Share added, but it could not be mounted - see its state in the list"
msgstr ""
"Partage ajouté, mais il n'a pas pu être monté – consultez son état dans la "
"liste"

#: src/session/mountactions.cpp:211
#, kde-format
msgid "no such share"
msgstr "ce partage n'existe pas"

#: src/session/mountactions.cpp:222
#, kde-format
msgid "could not fully remove %1: %2 - retry removal later"
msgstr ""
"impossible de supprimer entièrement %1 : %2 – réessayez la suppression plus "
"tard"

#: src/session/mountactions.cpp:227 src/session/mountactions.cpp:260
#: src/session/mountactions.cpp:300
#, kde-format
msgctxt "@info:status operation result"
msgid "Removed"
msgstr "Supprimé"

#: src/session/mountactions.cpp:228
#, kde-format
msgid ""
"removed the definition, but the local record could not be fully cleared - "
"retry from this list"
msgstr ""
"la définition a été supprimée, mais l'enregistrement local n'a pas pu être "
"entièrement effacé – réessayez depuis cette liste"

#: src/session/mountactions.cpp:261
#, kde-format
msgid "could not confirm local-record cleanup - retry"
msgstr ""
"impossible de confirmer le nettoyage de l'enregistrement local – réessayez"

#: src/session/mountactions.cpp:293
#, kde-format
msgid "no owned definition exists at %1"
msgstr ""
"aucune définition vous appartenant n'existe pour le point de montage %1"

#: src/session/mountmodel.cpp:67
#, kde-format
msgid "this saved record is missing required data"
msgstr "il manque des données requises dans cet enregistrement"

#: src/session/mountmodel.cpp:68
#, kde-format
msgid "no definition exists for this saved record"
msgstr "aucune définition n'existe pour cet enregistrement"

#: src/session/mountmodel.cpp:75
#, kde-format
msgid "requires administrator repair"
msgstr "nécessite une réparation par un administrateur"

#: src/session/mountmodel.cpp:88
#, kde-format
msgid ""
"saved settings do not match the actual definition - remove the local record, "
"then remove the resulting orphan definition"
msgstr ""
"les paramètres enregistrés ne correspondent pas à la définition réelle – "
"supprimez l'enregistrement local, puis la définition orpheline qui en résulte"

#: src/session/mountmodel.cpp:90
#, kde-format
msgid ""
"this share's saved convenience data is incomplete - remove the local record"
msgstr ""
"les données auxiliaires enregistrées de ce partage sont incomplètes – "
"supprimez l'enregistrement local"

#: src/session/mountmodel.cpp:104
#, kde-format
msgid "runtime state could not be determined - refresh and retry"
msgstr "impossible de déterminer l'état d'exécution – actualisez et réessayez"

#: src/session/mountmodel.cpp:110
#, kde-format
msgid ""
"mounted, but does not correlate with this definition - release it with its "
"owning tool, refresh, then retry"
msgstr ""
"monté, mais sans correspondance avec cette définition – démontez-le avec "
"l'outil qui l'a monté, actualisez, puis réessayez"

#: src/session/mountmodel.cpp:118
#, kde-format
msgid ""
"automount is active, but its instance id does not match what was recorded - "
"reboot or seek administrator help; never stopped or adopted automatically"
msgstr ""
"le montage automatique est actif, mais son identifiant d'instance ne "
"correspond pas à celui qui a été enregistré – redémarrez ou demandez l'aide "
"d'un administrateur ; il n'est jamais arrêté ni repris automatiquement"

#: src/session/mountmodel.cpp:127
#, kde-format
msgid "only one half of the pair exists - remove it, it is never repaired"
msgstr ""
"une seule moitié de la paire existe – supprimez-la, elle n'est jamais réparée "
"automatiquement"

#: src/session/mountmodel.cpp:135 src/session/mountmodel.cpp:146
#: src/session/mountmodel.cpp:161
#, kde-format
msgid "stored credential is missing or unhealthy"
msgstr ""
"le fichier d'identifiants est absent ou n'a pas passé les contrôles de "
"sécurité"

#. i18n: Keep identical to the Add form's access radio button.
#: src/session/mountmodel.cpp:177
#, kde-format
msgctxt "@item:inlistbox access mode"
msgid "Read only"
msgstr "Lecture seule"

#. i18n: Keep identical to the Add form's access radio button.
#: src/session/mountmodel.cpp:180
#, kde-format
msgctxt "@item:inlistbox access mode"
msgid "Read & Write"
msgstr "Lecture et écriture"

#. i18n: Keep identical to the Add form's access radio button.
#: src/session/mountmodel.cpp:183
#, kde-format
msgctxt "@item:inlistbox access mode"
msgid "Read & Write & Execute"
msgstr "Lecture, écriture et exécution"

#: src/session/mountmodel.cpp:196
#, kde-format
msgctxt "@item:inlistbox share state"
msgid "Inactive"
msgstr "Inactif"

#: src/session/mountmodel.cpp:198
#, kde-format
msgctxt "@item:inlistbox share state"
msgid "Ready"
msgstr "Prêt"

#: src/session/mountmodel.cpp:201
#, kde-format
msgctxt "@item:inlistbox share state"
msgid "Mounted"
msgstr "Monté"

#: src/session/mountmodel.cpp:203
#, kde-format
msgctxt "@item:inlistbox share state"
msgid "Missing credentials"
msgstr "Identifiants manquants"

#: src/session/mountmodel.cpp:205
#, kde-format
msgctxt "@item:inlistbox share state"
msgid "Broken"
msgstr "Défectueux"

#: src/session/mountmodel.cpp:207
#, kde-format
msgctxt "@item:inlistbox share state"
msgid "Busy"
msgstr "Occupé"

#: src/session/mountmodel.cpp:277
#, kde-format
msgctxt "@info:tooltip"
msgid "Requires administrator repair"
msgstr "Nécessite une réparation par un administrateur"

#: src/session/mountmodel.cpp:279
#, kde-format
msgctxt "@info:tooltip"
msgid "Mounted by another tool - unmount it with that tool"
msgstr "Monté par un autre outil – démontez-le avec cet outil"

#: src/session/mountmodel.cpp:281
#, kde-format
msgctxt "@info:tooltip"
msgid "Can't be removed right now: %1"
msgstr "Impossible à supprimer pour le moment : %1"

#: src/session/mountmodel.cpp:283
#, kde-format
msgctxt "@info:tooltip"
msgid "Can't be removed right now"
msgstr "Impossible à supprimer pour le moment"

#: src/session/mountmodel.cpp:366 src/session/mountmodel.cpp:384
#, kde-format
msgid "service status undefined"
msgstr "état du service non défini"

#: src/session/mountmodel.cpp:394
#, kde-format
msgid "service disabled - shares will not be armed at boot"
msgstr ""
"service désactivé – les partages ne seront pas préparés au montage au "
"démarrage"

#: src/session/mountmodel.cpp:400
#, kde-format
msgid "service failed to start - shares may not be armed (check %1)"
msgstr ""
"échec du démarrage du service – le montage à la demande des partages n'est "
"peut-être pas activé (vérifiez %1)"

#: src/session/mountmodel.cpp:405
#, kde-format
msgid "service enabled"
msgstr "service activé"

#: src/session/mountmodel.cpp:749
#, kde-format
msgid "mounted by another tool"
msgstr "monté par un autre outil"

#: src/session/mountpointcheck.cpp:44
#, kde-format
msgid "Choose a folder to mount the share on"
msgstr "Choisissez le dossier sur lequel monter le partage"

#. i18n: %1 is the tilde character, the shorthand for the home folder.
#: src/session/mountpointcheck.cpp:53
#, kde-format
msgid "Only %1 for your own home folder is supported; enter the full path"
msgstr ""
"Seul %1 est pris en charge pour votre propre dossier personnel ; saisissez "
"le chemin complet"

#: src/session/mountpointcheck.cpp:78
#, kde-format
msgid "Another mount already uses this folder"
msgstr "Un autre montage utilise déjà ce dossier"

#: src/session/mountpointcheck.cpp:86
#, kde-format
msgid "This folder is inside another mount (%1)"
msgstr "Ce dossier se trouve à l'intérieur d'un autre montage (%1)"

#: src/session/shareaddress.cpp:50
#, kde-format
msgid "This URL contains a malformed %1 escape: %2"
msgstr "Cette URL contient une séquence d'échappement %1 mal formée : %2"

#: src/session/shareaddress.cpp:60
#, kde-format
msgid "Not a valid address: %1"
msgstr "Adresse non valide : %1"

#. i18n: %1 is the URL scheme "smb://", %2 the address as entered.
#: src/session/shareaddress.cpp:66
#, kde-format
msgid "Not an %1 URL: %2"
msgstr "Ce n'est pas une URL %1 : %2"

#: src/session/shareaddress.cpp:74
#, kde-format
msgid ""
"This URL has parts that are not supported here (port, password, query or "
"fragment): %1"
msgstr ""
"Cette URL comporte des éléments non pris en charge ici (port, mot de passe, "
"requête ou fragment) : %1"

#: src/session/shareaddress.cpp:80
#, kde-format
msgid "No host in URL: %1"
msgstr "Aucun hôte dans l'URL : %1"

#: src/session/shareaddress.cpp:84
#, kde-format
msgid "IPv6 hosts are not supported yet: %1"
msgstr "Les hôtes IPv6 ne sont pas encore pris en charge : %1"

#. i18n: %1 is an example share address.
#: src/session/shareaddress.cpp:97
#, kde-format
msgid ""
"This points at a server, not a share - add the share name after the server "
"(%1)."
msgstr ""
"Ceci désigne un serveur et non un partage – ajoutez le nom du partage après "
"le serveur (%1)."

#: src/session/shareaddress.cpp:105
#, kde-format
msgid "The URL contains control characters."
msgstr "L'URL contient des caractères de contrôle."

#. i18n: %1 is an example share address. Shown capitalised on a line of
#. i18n: its own, so start with a word rather than a placeholder.
#: src/session/shareaddress.cpp:167
#, kde-format
msgid "not a share address (expected %1)"
msgstr "ce n'est pas une adresse de partage (attendu : %1)"

#. i18n: Shown capitalised on a line of its own, so start with a word
#. i18n: rather than a placeholder.
#: src/session/shareaddress.cpp:177
#, kde-format
msgid "the share address contains control characters"
msgstr "l'adresse du partage contient des caractères de contrôle"

#. i18n: Shown capitalised on a line of its own, so start with a word
#. i18n: rather than a placeholder.
#: src/session/shareaddress.cpp:185
#, kde-format
msgid "the share address may not contain a comma"
msgstr "l'adresse du partage ne peut pas contenir de virgule"

#. i18n: %1 is an example share address, %2 the parent-directory path
#. i18n: component that is refused. Shown capitalised on a line of its
#. i18n: own, so start with a word rather than a placeholder.
#: src/session/shareaddress.cpp:194
#, kde-format
msgid "not a valid share address (expected %1, with no '%2' component)"
msgstr "adresse de partage non valide (attendu : %1, sans composant « %2 »)"

#. i18n: %1 is the URL scheme "smb://". Username is the Add form's
#. i18n: field label; use its translation. Shown capitalised on a
#. i18n: line of its own, so start with a word rather than a
#. i18n: placeholder.
#: src/session/shareaddress.cpp:205
#, kde-format
msgid ""
"the %1 address names a user - enter it in Username, or remove it from the "
"address"
msgstr ""
"l'adresse %1 indique un utilisateur – saisissez-le dans « Nom "
"d'utilisateur » ou retirez-le de l'adresse"

#. i18n: %1 is the URL scheme "smb://". Username is the Add form's
#. i18n: field label; use its translation. Shown capitalised on a
#. i18n: line of its own, so start with a word rather than a
#. i18n: placeholder.
#: src/session/shareaddress.cpp:214
#, kde-format
msgid "the %1 address names a different user than the Username field"
msgstr ""
"l'adresse %1 indique un autre utilisateur que celui du champ « Nom "
"d'utilisateur »"

#. i18n: %1 is an example share address.
#: src/session/shareaddress.cpp:245
#, kde-format
msgid "Enter the share address, for example %1"
msgstr "Saisissez l'adresse du partage, par exemple %1"

#. i18n: %1 is the URL scheme "smb://".
#: src/session/shareaddress.cpp:269
#, kde-format
msgid "Choose a folder on a network share (%1)"
msgstr "Choisissez un dossier sur un partage réseau (%1)"

#: src/session/shareaddress.cpp:276
#, kde-format
msgid ""
"This address has parts that are not supported here (port, password, query or "
"fragment)"
msgstr ""
"Cette adresse comporte des éléments non pris en charge ici (port, mot de "
"passe, requête ou fragment)"

#: src/session/shareaddress.cpp:283
#, kde-format
msgid "Choose a share on a server, not the network root"
msgstr "Choisissez un partage sur un serveur, et non la racine du réseau"

#: src/session/shareaddress.cpp:287
#, kde-format
msgid "IPv6 hosts are not supported yet"
msgstr "Les hôtes IPv6 ne sont pas encore pris en charge"

#: src/session/shareaddress.cpp:301
#, kde-format
msgid "The address contains control characters"
msgstr "L'adresse contient des caractères de contrôle"

#: src/session/store.cpp:119
#, kde-format
msgid "share record changed since it was read; reload and retry"
msgstr ""
"l'enregistrement du partage a changé depuis sa lecture ; rechargez et "
"réessayez"

#: src/session/store.cpp:128
#, kde-format
msgid "could not write configuration to disk"
msgstr "impossible d'écrire la configuration sur le disque"

#. i18n: %1 is the name of an environment variable.
#: src/session/userlock.cpp:52
#, kde-format
msgid "%1 is not set"
msgstr "%1 n'est pas défini"

#. i18n: %2 is the C library's description of the error, which the C
#. i18n: library localizes by itself.
#: src/session/userlock.cpp:63
#, kde-format
msgid "cannot open %1: %2"
msgstr "impossible d'ouvrir %1 : %2"

#. i18n: %2 is the C library's description of the error, which the C
#. i18n: library localizes by itself.
#: src/session/userlock.cpp:69
#, kde-format
