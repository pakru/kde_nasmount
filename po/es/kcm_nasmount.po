#: src/kcm/ui/main.qml:379
#, kde-format
msgid "Remove the network mount at %1?"
msgstr "¿Eliminar el montaje de red con el punto de montaje %1?"

#: src/kcm/ui/main.qml:381
#, kde-format
msgid ""
"Remove the definition at %1?\n"
"\n"
"You have no saved settings for it, so adding it again means entering "
"everything anew."
msgstr ""
"¿Eliminar la definición con el punto de montaje %1?\n"
"\n"
"No tiene ajustes guardados para ella, así que volver a añadirla implica "
"introducirlo todo de nuevo."

#: src/kcm/ui/main.qml:383
#, kde-format
msgid ""
"Remove your saved settings for %1?\n"
"\n"
"No mount definition is touched and nothing is unmounted."
msgstr ""
"¿Eliminar sus ajustes guardados para %1?\n"
"\n"
"No se modifica ninguna definición de montaje y no se desmonta nada."
