#: src/kcm/ui/main.qml:381
#, kde-format
msgid ""
"Remove the definition at %1?\n"
"\n"
"You have no saved settings for it, so adding it again means entering "
"everything anew."
msgstr ""
"Remover a definição com o ponto de montagem %1?\n"
"\n"
"Você não tem configurações salvas para ela, então adicioná-la novamente "
"significa digitar tudo de novo."

#: src/kcm/ui/main.qml:383
#, kde-format
msgid ""
"Remove your saved settings for %1?\n"
"\n"
"No mount definition is touched and nothing is unmounted."
msgstr ""
"Remover as suas configurações salvas para %1?\n"
"\n"
"Nenhuma definição de montagem é alterada e nada é desmontado."
