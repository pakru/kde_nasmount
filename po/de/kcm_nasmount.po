msgstr "Klicken Sie auf „Hinzufügen …“, um eines zu erstellen."

#: src/kcm/ui/main.qml:351
msgctxt "@title:window"
msgid "Remove saved settings"
msgstr "Gespeicherte Einstellungen entfernen"

#: src/kcm/ui/main.qml:352
msgctxt "@title:window"
msgid "Remove network mount"
msgstr "Netzwerklaufwerk entfernen"

#: src/kcm/ui/main.qml:379
#, kde-format
msgid "Remove the network mount at %1?"
msgstr "Das Netzwerklaufwerk mit dem Einhängepunkt %1 entfernen?"

#: src/kcm/ui/main.qml:381
#, kde-format
msgid ""
"Remove the definition at %1?\n"
"\n"
"You have no saved settings for it, so adding it again means entering "
"everything anew."
msgstr ""
"Die Definition mit dem Einhängepunkt %1 entfernen?\n"
"\n"
"Sie haben dafür keine gespeicherten Einstellungen, ein erneutes Hinzufügen "
"erfordert also, alles neu einzugeben."

#: src/kcm/ui/main.qml:383
#, kde-format
msgid ""
"Remove your saved settings for %1?\n"
"\n"
"No mount definition is touched and nothing is unmounted."
msgstr ""
"Ihre gespeicherten Einstellungen für %1 entfernen?\n"
"\n"
"Es wird keine Einhängedefinition verändert und nichts ausgehängt."
