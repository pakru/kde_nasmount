msgctxt "@option:radio"
msgid "Read & Write & Execute"
msgstr "Lesen, Schreiben und Ausführen"

#: src/kcm/ui/ShareForm.qml:502
msgctxt "@info:tooltip"
msgid ""
"Read, Write and Execution access to remote files\n"
"Allows programs stored on the share to run"
msgstr ""
"Lesender, schreibender und ausführender Zugriff auf entfernte Dateien\n"
"Erlaubt das Ausführen von Programmen, die auf der Freigabe gespeichert sind"

#. i18n: "System Settings" is the name of KDE's settings application:
#. write it as that application is named in your language.
#: src/kcm/ui/ShareForm.qml:510
msgid "To change a network mount, remove and add it again in System Settings"
msgstr ""
"Um ein Netzwerklaufwerk zu ändern, entfernen Sie es und fügen Sie es in den "
"Systemeinstellungen erneut hinzu"

