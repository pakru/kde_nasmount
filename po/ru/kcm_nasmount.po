#, kde-format
msgctxt "@item:inlistbox share state"
msgid "Ready"
msgstr "Готово"

#: src/session/mountmodel.cpp:201
#, kde-format
msgctxt "@item:inlistbox share state"
msgid "Mounted"
msgstr "Подключено"

#: src/session/mountmodel.cpp:203
#, kde-format
msgctxt "@item:inlistbox share state"
msgid "Missing credentials"
msgstr "Нет учётных данных"

#: src/session/mountmodel.cpp:205
#, kde-format
