#. i18n: Shown capitalised on a line of its own, so start with a word
#. i18n: rather than a placeholder.
#: src/session/shareaddress.cpp:185
#, kde-format
msgid "the share address may not contain a comma"
msgstr "адрес общей папки не может содержать запятую"

#. i18n: %1 is an example share address, %2 the parent-directory path
#. i18n: component that is refused. Shown capitalised on a line of its
#. i18n: own, so start with a word rather than a placeholder.
#: src/session/shareaddress.cpp:194
#, kde-format
msgid "not a valid share address (expected %1, with no '%2' component)"
msgstr "недопустимый адрес общей папки (ожидается %1 без компонента «%2»)"

#. i18n: %1 is the URL scheme "smb://". Username is the Add form's
#. i18n: field label; use its translation. Shown capitalised on a
#. i18n: line of its own, so start with a word rather than a
#. i18n: placeholder.
#: src/session/shareaddress.cpp:205
#, kde-format
msgid ""
"the %1 address names a user - enter it in Username, or remove it from the "
"address"
msgstr ""
"адрес %1 содержит имя пользователя — введите его в поле «Имя пользователя» "
"или удалите из адреса"

#. i18n: %1 is the URL scheme "smb://". Username is the Add form's
#. i18n: field label; use its translation. Shown capitalised on a
#. i18n: line of its own, so start with a word rather than a
#. i18n: placeholder.
#: src/session/shareaddress.cpp:214
#, kde-format
msgid "the %1 address names a different user than the Username field"
msgstr "в адресе %1 указан не тот пользователь, что в поле «Имя пользователя»"

#. i18n: %1 is an example share address.
#: src/session/shareaddress.cpp:245
#, kde-format
