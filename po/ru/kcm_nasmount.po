msgstr "Сейчас удалить нельзя: %1"

#: src/session/mountmodel.cpp:283
#, kde-format
msgctxt "@info:tooltip"
msgid "Can't be removed right now"
msgstr "Сейчас удалить нельзя"

#: src/session/mountmodel.cpp:366 src/session/mountmodel.cpp:384
#, kde-format
msgid "service status undefined"
msgstr "состояние службы не определено"

#: src/session/mountmodel.cpp:394
#, kde-format
msgid "service disabled - shares will not be armed at boot"
msgstr ""
"служба отключена — общие папки не будут подготовлены к подключению при "
"загрузке"

#: src/session/mountmodel.cpp:400
#, kde-format
msgid "service failed to start - shares may not be armed (check %1)"
msgstr ""
"не удалось запустить службу — общие папки могут быть не подготовлены к "
"подключению (проверьте %1)"

#: src/session/mountmodel.cpp:405
#, kde-format
msgid "service enabled"
msgstr "служба включена"

#: src/session/mountmodel.cpp:749
#, kde-format
msgid "mounted by another tool"
msgstr "подключено другой программой"

#: src/session/mountpointcheck.cpp:44
#, kde-format
msgid "Choose a folder to mount the share on"
msgstr "Выберите локальную папку, в которую будет подключена общая папка"

