msgstr "Выберите общую папку на сервере, а не корень сети"

#: src/session/shareaddress.cpp:287
#, kde-format
msgid "IPv6 hosts are not supported yet"
msgstr "Узлы IPv6 пока не поддерживаются"

#: src/session/shareaddress.cpp:301
#, kde-format
msgid "The address contains control characters"
msgstr "Адрес содержит управляющие символы"

#: src/session/store.cpp:119
#, kde-format
