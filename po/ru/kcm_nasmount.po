#: src/session/mountpointcheck.cpp:53
#, kde-format
msgid "Only %1 for your own home folder is supported; enter the full path"
msgstr ""
"Знак %1 поддерживается только для вашей домашней папки; введите полный путь"

#: src/session/mountpointcheck.cpp:78
#, kde-format
