#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	cmake -S . -B build \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DNASMOUNT_PACKAGE_FAMILY=deb

override_dh_auto_build:
	cmake --build build --parallel

override_dh_auto_test:
	ctest --test-dir build --output-on-failure

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/tmp cmake --install build

# Restart the boot coordinator after an upgrade so the new nasmount-boot
# re-validates and re-arms. Safe against shares that already exist: every
# branch of Root::Arming::evaluateArmPrecheck() returns before the mount
# point, the credential, or systemd is touched, and `startedByUs` is false on
# each of them, so a restart can never stop a live automount it did not
# create. A currently mounted share takes the Blocked branch and is logged and
# skipped -- `a live mount already occupies the path` is expected here, not a
# fault. Made explicit rather than inherited from the debhelper default.
override_dh_installsystemd:
	dh_installsystemd --restart-after-upgrade nasmount-boot.service

override_dh_installchangelogs:
	dh_installchangelogs
	printf '%s\n' \
		/usr/share/doc/nasmount/changelog.Debian.gz \
		/usr/share/doc/nasmount/copyright \
		>> debian/nasmount/usr/share/nasmount/cleanup-manifest.txt

override_dh_compress:
	dh_compress -XLICENSE
